# ============================================================
# AI Video Factory — Environment configuration template
# Copy this file to `.env` and fill in your keys.
# NEVER commit the real `.env` file. Keys are read at runtime
# only; they are never stored in the database or logs.
# ============================================================

# --- LLM providers ---
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Image providers ---
STABILITY_API_KEY=
HUGGINGFACE_API_KEY=

# --- Voice providers ---
ELEVENLABS_API_KEY=

# --- Local AI endpoints (no keys needed) ---
OLLAMA_BASE_URL=http://localhost:11434
COMFYUI_BASE_URL=http://localhost:8188
SD_WEBUI_BASE_URL=http://localhost:7860
LOCAL_TTS_BASE_URL=http://localhost:5000

# --- Model overrides (optional — each provider has a sane default) ---
OLLAMA_MODEL=llama3.1
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENAI_MODEL=gpt-4o-mini

# --- Image model overrides (optional) ---
# ComfyUI checkpoint name exactly as shown in ComfyUI
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
HUGGINGFACE_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
# Stability engine: core | ultra
STABILITY_IMAGE_MODEL=core
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Video (image-to-video) overrides (optional) ---
# Custom ComfyUI i2v workflow template (API format). The bundled template at
# assets/templates/comfyui_i2v_template.json is a documented starting point —
# adapt it to your ComfyUI install (AnimateDiff/SVD + VHS_VideoCombine).
#COMFYUI_I2V_TEMPLATE=/path/to/my_i2v_workflow.json

# --- App behaviour overrides (optional) ---
# DEMO_MODE=true
# AVF_LOG_LEVEL=INFO
# AVF_FFMPEG_PATH=/usr/bin/ffmpeg
